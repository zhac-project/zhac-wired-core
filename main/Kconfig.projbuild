menu "ZHAC wired-core board"

    # Guition JC-ESP32P4-M3-DEV values. MDC/MDIO/REF_CLK match ESP-IDF's
    # ETH_ESP32_EMAC_DEFAULT_CONFIG() for esp32p4 exactly, so the RMII data
    # pins are left at the IDF defaults too (28/29/30/34/35/49) and are not
    # exposed here -- each RMII signal picks independently from its own small
    # IO_MUX candidate set, and this board follows the IDF default for all of
    # them. A custom board would expose these; this one does not need to.
    #
    # ADDING A SECOND TARGET: keep ONE symbol per signal and give it a
    # per-target default rather than duplicating the block behind
    # `if IDF_TARGET_...`. Kconfig takes the first matching default:
    #
    #     config ZHAC_ETH_MDC_GPIO
    #         int "EMAC MDC GPIO"
    #         default 5  if IDF_TARGET_ESP32S31   # RGMII, YT8531
    #         default 31                          # P4 / IP101, RMII
    #
    # That keeps eth_common.cpp and the API identical across SKUs; only the
    # per-board eth_phy_*.cpp reads the values. Note the S31 is RGMII, so it
    # additionally needs TX/RX clock pins and the data-plane set, which RMII
    # does not have -- those belong in its own block, not retrofitted here.

    # SMI (MDC/MDIO) is the one pair both PHYs need. Per-target defaults, one
    # symbol per signal -- see the note above.
    config ZHAC_ETH_MDC_GPIO
        int "EMAC MDC GPIO"
        default 5 if IDF_TARGET_ESP32S31
        default 31

    config ZHAC_ETH_MDIO_GPIO
        int "EMAC MDIO GPIO"
        default 6 if IDF_TARGET_ESP32S31
        default 52

    config ZHAC_ETH_PHY_ADDR
        int "Ethernet PHY SMI address (-1 = autodetect)"
        default -1 if IDF_TARGET_ESP32S31
        default 1

    # --- P4 / IP101 / RMII only ---
    # The RGMII data and clock pins on the S31 are not Kconfig: there are ten
    # of them plus two clocks, they are board-fixed, and exposing them would be
    # noise. They live in eth_phy_yt8531_rgmii.cpp.
    config ZHAC_ETH_REF_CLK_GPIO
        int "EMAC RMII REF_CLK input GPIO"
        depends on IDF_TARGET_ESP32P4
        default 50
        help
            RMII-only concept -- RGMII has separate Rx and Tx clocks instead.
            Sourced by the PHY (EMAC_CLK_EXT_IN); valid inputs are GPIO32,
            GPIO44 and GPIO50 only.

    config ZHAC_ETH_PHY_PWR_GPIO
        int "IP101 PHY power/enable GPIO (-1 if always on)"
        depends on IDF_TARGET_ESP32P4
        default 51
        help
            Must be driven high and held before the PHY is probed, or SMI
            reads return all-ones and PHY detection fails with a misleading
            "no PHY found".

    # --- S31 / YT8531 / RGMII only ---
    config ZHAC_ETH_PHY_RST_GPIO
        int "PHY reset GPIO (-1 if none)"
        depends on IDF_TARGET_ESP32S31
        default 7
        help
            Handed to the generic PHY driver (eth_phy_config_t.reset_gpio_num)
            so it performs a proper reset pulse before probing. Note the P4
            board uses the equivalent line as a always-high power enable
            instead -- see ZHAC_ETH_PHY_PWR_GPIO.

    config ZHAC_API_AUTH_DEFAULT_ENABLED
        bool "Require sign-in for the REST and WebSocket APIs on a fresh unit"
        default y
        help
            Secure by default, as on the dual-chip build: a fresh hub asks the
            first visitor to choose the admin password, and every API call
            needs the token that password unlocks. A choice stored from the
            web UI (Settings -> Auth) always wins over this default. Turn it
            off only for a lab bench -- auth off means anyone on the LAN can
            run Lua, reflash and reset the network.

    config ZHAC_MDNS_HOSTNAME
        string "mDNS hostname (without .local)"
        default "zhac"
        help
            Two units on one LAN both defaulting to "zhac" collide; mDNS
            conflict resolution renames one of them, so trust the name in
            the boot log over this value. Set it per unit to avoid the
            ambiguity. This is the whole discovery story on a wired box --
            there is no SoftAP and no provisioning page.

    # -- Radio --
    config ZHAC_ESP_ZIGBEE
        bool "Enable the Zigbee radio (esp_zigbee_backend)"
        default y
        select ZB_ENABLED
        help
            Phase 1. Runs esp-zigbee-lib as coordinator with the stack on THIS
            SoC, and registers it as ZHAC's DeviceBackend. The lib's own
            Kconfig picks the PHY per target: native 802.15.4 on the S31,
            Radio-Spinel UART to a C6 running ot_rcp on the P4.

            Turn off for a radio-less build; components/zigbee_mgr/
            radio_stubs.cpp then answers the radio entry points with refusals
            and /api/devices stays empty.

    config ZHAC_ZB_MAX_CHILDREN
        int "Max direct children of the coordinator"
        depends on ZHAC_ESP_ZIGBEE
        default 32
        help
            Neighbour/routing table allocations scale with this, so it is a
            real RAM knob, not just a policy limit.

    config ZHAC_ZB_STORAGE_PARTITION
        string "NVS partition holding Zigbee datasets"
        depends on ZHAC_ESP_ZIGBEE
        default "zb_storage"
        help
            Must exist in partitions.csv as type `data`, subtype `nvs`.
            NOT `fat`: esp-zigbee-lib v2.x opens it with
            nvs_open_from_partition() and abort()s if that fails. IDF's own
            bundled zigbee examples still declare fat because they are v1.x.

    config ZHAC_ZB_CHANNEL_MASK
        hex "Primary channel mask"
        depends on ZHAC_ESP_ZIGBEE
        default 0x07FFF800
        help
            Default is all channels 11-26. Narrow it to pin the network to a
            channel away from local Wi-Fi.

    config ZHAC_RCP_UART_PORT
        int "UART port to the RCP (P4 only)"
        depends on ZHAC_ESP_ZIGBEE && !ZB_RADIO_NATIVE
        default 1

    # -- Radio wiring --
    # The C6's former SDIO traces, freed by the no-WiFi decision: SDIO D0 is
    # P4 GPIO14 <-> C6 GPIO20 and D1 is P4 GPIO15 <-> C6 GPIO21 (C6 SDIO slave
    # pins are fixed by silicon). So the C6 must transmit on 20 and receive on
    # 21 -- which is what rcp/sdkconfig.defaults builds ot_rcp with. Not yet
    # confirmed on hardware: if spinel never answers, swap one side.
    config ZHAC_RCP_UART_RX_GPIO
        int "P4 RX from RCP TX (C6 GPIO20)"
        default 14

    config ZHAC_RCP_UART_TX_GPIO
        int "P4 TX to RCP RX (C6 GPIO21)"
        default 15

    config ZHAC_RCP_RESET_GPIO
        int "RCP reset (to C6 EN)"
        default 54

    config ZHAC_RCP_BOOT_GPIO
        int "RCP BOOT strap (C6 GPIO9), -1 if unwired"
        default -1
        help
            Needed only by esp_rcp_update for host-driven reflash, which also
            needs the RCP UART to be the C6's UART0 pins (16/17) -- the ROM
            download mode listens nowhere else. On the Guition board neither
            holds, so the C6 is flashed once through its own header; see
            README "Zigbee radio (ESP32-C6)" and tools/build-rcp.sh.

    config ZHAC_STATUS_LED_GPIO
        int "Status LED GPIO (one addressable WS2812 RGB LED), -1 = none"
        default 60 if IDF_TARGET_ESP32S31
        default -1
        help
            Green blink while the join window is open, blue flash on Zigbee
            traffic, off otherwise. The S31 dev board has one on GPIO 60.

endmenu

# The cloud link (remote_client, pulled from zhac-net-core by path). That
# component has no Kconfig of its own -- each firmware root defines these
# symbols -- and this root never did, so every wired build compiled the client
# out: no cloud link, and the web UI hid the Remote card.
menu "ZHAC Remote (cloud link)"

    config ZHAC_REMOTE_CLIENT_ENABLE
        bool "Build the cloud link (WSS client)"
        default y
        help
            Compiles the client in; it stays idle until a URL and token are
            saved in Settings -> Remote, so building it costs nothing at run
            time. Default y here (net-core defaults it n and turns it on in
            sdkconfig.defaults) so an existing sdkconfig picks it up too.

    config ZHAC_REMOTE_TX_QUEUE_DEPTH
        int "Remote TX queue depth (events)"
        depends on ZHAC_REMOTE_CLIENT_ENABLE
        default 16
        range 4 64

    config ZHAC_REMOTE_PING_INTERVAL_S
        int "WSS ping interval (s)"
        depends on ZHAC_REMOTE_CLIENT_ENABLE
        default 20
        range 5 120

    config ZHAC_REMOTE_BACKOFF_MAX_S
        int "Reconnect backoff cap (s)"
        depends on ZHAC_REMOTE_CLIENT_ENABLE
        default 60
        range 5 600

    config ZHAC_REMOTE_TASK_STACK_KB
        int "Remote task stack (KB)"
        depends on ZHAC_REMOTE_CLIENT_ENABLE
        default 12
        range 6 32
        help
            Cloud commands run the same handlers the local WebSocket runs on
            the 12 KB httpd worker, and on this build they call the Zigbee,
            rules and Lua code directly. Keep it at least as deep as that.

    config ZHAC_REMOTE_ALLOW_PRIVILEGED
        bool "Allow the cloud to invoke privileged commands"
        depends on ZHAC_REMOTE_CLIENT_ENABLE
        default n
        help
            Off: the cloud cannot reflash, reset the network, run or write
            Lua, delete devices or change settings -- only reads and
            recoverable device, rule and group operations. Turn on only for
            a cloud endpoint you operate and trust.

endmenu
