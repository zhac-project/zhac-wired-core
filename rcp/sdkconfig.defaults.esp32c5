#
# ESP32-C5 radio for the S31 Wi-Fi test variant S-B (sdkconfig.defaults.wifi-native-s31).
# IDF loads this right after rcp/sdkconfig.defaults when the target is esp32c5
# (RCP_TARGET=esp32c5 tools/build-rcp.sh), so only the pins change:
#   C5 GPIO9 (TX) -> S31 GPIO20 (RX)     J2-26 (D0)
#   C5 GPIO8 (RX) <- S31 GPIO21 (TX)     J2-27 (D1)
# Neither is a C5 strapping pin. UART0's own pins (11/12) stay on the
# DevKitC-1's USB bridge, so the C5 is flashed through its own USB port.
CONFIG_OPENTHREAD_UART_TX_PIN=9
CONFIG_OPENTHREAD_UART_RX_PIN=8
