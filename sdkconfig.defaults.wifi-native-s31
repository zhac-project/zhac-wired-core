#
# Wi-Fi test variant S-B on the ESP32-S31-Function-CoreBoard-1: the S31's own
# radio does Wi-Fi, and Zigbee runs on an external radio chip (C5, C6 or H2)
# with ot_rcp, over UART. tools/build-p4-wifi-hosted.sh s31-native loads this
# LAST, after sdkconfig.defaults(.esp32s31), in place of the ESP-Hosted files.
# Background: extra/docs/research/WIFI_COPROCESSORS_2026-10-19.md, section S-B.
#
#   signal       dir        S31 GPIO  J2 pin (label)  radio chip
#   UART RX      RCP->S31   20        26 (D0)         ot_rcp TX
#   UART TX      S31->RCP   21        27 (D1)         ot_rcp RX
#   Reset        S31->RCP   47        13              EN (RES on the C5 kit)
#   GND          --         GND       33/34           GND
#
# Same J2 pins as the ESP-Hosted wiring, so its D0/D1 jumpers can stay. The
# reset line is not driven by the firmware yet; 47 only keeps the setting off
# the default (54 is an audio pin on this board).

CONFIG_ZHAC_WIFI_HOSTED=y
CONFIG_ZHAC_WIFI_NATIVE=y

# Zigbee on the external RCP: 460800 baud, no flow control (esp_zigbee_backend).
CONFIG_ZB_RADIO_SPINEL_UART=y
CONFIG_ZHAC_RCP_UART_PORT=1
CONFIG_ZHAC_RCP_UART_RX_GPIO=20
CONFIG_ZHAC_RCP_UART_TX_GPIO=21
CONFIG_ZHAC_RCP_RESET_GPIO=47
# The S31's 802.15.4 driver is unused now; off also drops Wi-Fi/802.15.4
# coexistence.
# CONFIG_IEEE802154_ENABLED is not set

# esp-idf#18791 (IDF v6.1 tag; fixed on release/v6.1 by c566ace1f6): with the
# native Wi-Fi driver linked and the firmware running from PSRAM, the driver's
# log strings that esp_wifi/linker.lf sends to NOLOAD (every level above the
# maximum) break the link: "cannot move location counter backwards" in
# .ext_ram.dummy. At VERBOSE no level is above the maximum, so nothing goes to
# NOLOAD. Costs image size (debug/verbose strings stay in) and the runtime
# level check on ESP_LOGD/V calls; the default level stays INFO.
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# Internal RAM is the S31's tight spot. The firmware runs from PSRAM, so the
# driver's hot paths stay there instead of being copied into internal RAM, and
# Wi-Fi/lwIP buffers are taken from PSRAM first.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
