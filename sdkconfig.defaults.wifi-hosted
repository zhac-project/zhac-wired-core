#
# Wi-Fi test variant: the P4 plus an ESP32-C5 running ESP-Hosted on SPI full
# duplex. tools/build-p4-wifi-hosted.sh loads this LAST, after
# sdkconfig.defaults (and sdkconfig.defaults.p4rev3x on v3.x silicon).
# The C5 side is tools/c5-wifi-cp.defaults; the two pin lists must match.
#
#   signal       dir      P4 GPIO  NANO header   C5 GPIO  C5-DevKitC-1
#   CLK          P4->C5   20       P1            6        J1-7
#   MOSI         P4->C5   4        P1            8        J1-9
#   MISO         C5->P4   5        P1            9        J1-10
#   CS           P4->C5   32       P1            10       J1-11
#   Handshake    C5->P4   33       P1            23       J3-5
#   Data Ready   C5->P4   3        P2-9          24       J3-4
#   Reset        P4->C5   2        P2-11         RST/EN   J1-2
#   GND          --       GND      several       GND      J1-15, J3-1, J3-12
#
# P4 pins: the seven free on BOTH the Guition JC-ESP32P4-M3-DEV and the
# Waveshare ESP32-P4-NANO headers, clear of the C6 radio (14/15 spinel, 54
# reset, 6 = C6 IO2) and of the P4 strapping pins (34-38). C5 pins avoid its
# strapping pins (2, 3, 7, 25-28), its console UART (11/12) and USB (13/14).
# Jumpers <= 10 cm, several grounds, C5 powered from its own USB.

CONFIG_ZHAC_WIFI_HOSTED=y

CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
# The C5 can do SDIO, and esp_hosted would pick it -- on the C6 radio's pins.
CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SPI_PRIV_MODE_3_ESP32XX=y
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_CLK=20
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_MOSI=4
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_MISO=5
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_CS=32
CONFIG_ESP_HOSTED_SPI_GPIO_HANDSHAKE=33
CONFIG_ESP_HOSTED_SPI_GPIO_DATA_READY=3
CONFIG_ESP_HOSTED_SPI_GPIO_RESET_SLAVE=2
# Jumper wires: start low, raise once the link is proven.
CONFIG_ESP_HOSTED_SPI_FREQ_ESP32XX=10
# A loose jumper must not reboot the hub: report the failure, keep Zigbee up.
# CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE is not set
