#
# ESP32-P4 silicon v3.x: the `-p4-rev3x-` release images (hub and C6 radio
# installer). tools/build-p4-rev3x.sh loads this file LAST, after
# sdkconfig.defaults(.esp32p4), so it turns off the v0.x-v1.x gate set there.
# Everything else is the v1.x build. The family's own defaults apply: minimum
# revision v3.1 and 400 MHz (v1.x tops out at 360).
# Check what came out: tools/check_resolved_config.sh build.p4rev3x/sdkconfig rev3x
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
